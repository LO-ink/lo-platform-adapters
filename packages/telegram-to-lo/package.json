  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LO-ink/lo-platform-adapters.git",
    "directory": "packages/telegram-to-lo"
  },
  "publishConfig": {
    "access": "public"
  }
