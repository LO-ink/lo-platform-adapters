{
  "name": "@lo-ink/adapter-telegram-to-lo",
  "version": "0.1.5",
  "description": "Opt-in migration bridge for existing Telegram Mini Apps running in LO",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@lo-ink/miniapp-sdk": "^0.19.2 || ^0.20.0 || ^0.21.0 || ^0.22.0"
