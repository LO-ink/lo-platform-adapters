{
  "name": "@lo-ink/adapter-lo",
  "version": "0.24.1",
  "description": "Compatibility exports for native LO transport in Mini App SDK",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
