  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lo-ink/lo-platform-adapters.git",
    "directory": "packages/lo"
  },
  "publishConfig": {
    "access": "public"
  }
