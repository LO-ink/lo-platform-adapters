    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@lo/bot-sdk": "^0.1.0"
  },
  "devDependencies": {
    "@lo/bot-sdk": "file:vendor/lo-bot-sdk-0.1.0.tgz",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lo-ink/lo-platform-adapters.git",
    "directory": "packages/bot-http-lo"
  },
  "publishConfig": {
    "access": "public"
  }
