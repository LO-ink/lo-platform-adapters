{
  "name": "@lo-ink/bot-http-lo",
  "version": "0.6.0",
  "description": "Compatibility exports for native HTTP transport in LO Bot SDK",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "contract.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": "./contract.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@lo-ink/bot-sdk": "^0.5.0"
  },
  "devDependencies": {
    "@lo-ink/bot-sdk": "0.5.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LO-ink/lo-platform-adapters.git",
    "directory": "packages/bot-http-lo"
  },
  "publishConfig": {
    "access": "public"
  }
}
