{
  "name": "lo-platform-adapters-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && tsc -p examples/tsconfig.json",
    "format:check": "prettier --check .",
    "test:package": "node scripts/test-packages.mjs",
    "test": "npm run build && node --test test/*.test.mjs && npm test --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "architecture": "depcruise --config .dependency-cruiser.cjs packages/*/src examples",
    "format": "prettier --write .",
    "security": "npm audit --audit-level=high",
    "test:coverage": "c8 npm test",
    "policy": "node --test scripts/check-policy.test.mjs && node scripts/check-policy.mjs",
    "secrets": "node scripts/check-secrets.mjs",
    "ci": "make ci"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lo-ink/miniapp-sdk": "0.22.3",
    "c8": "12.0.0",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "yaml": "2.9.1"
  }
}
